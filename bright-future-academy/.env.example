# ============================================================
# Bright Future Academy - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# ============================================================

# Server
SERVER_PORT=8080

# Database
DATABASE_URL=jdbc:mysql://localhost:3306/bright_future_academy?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password

# JWT Secret (minimum 256-bit / 32 characters)
JWT_SECRET=YourSuperSecretKeyAtLeast256BitsLongForJWTSigning

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Storage
FILE_STORAGE_PATH=./uploads

# Mail (optional - for future email notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
